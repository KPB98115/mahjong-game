{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@app/*": ["../src/*"],
      "@schema": ["../db/schema.ts"],
      "@schema/*": ["../db/schema/*"],
      "void/db": ["../.void/db.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
