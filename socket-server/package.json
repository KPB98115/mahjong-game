{
  "name": "mahjong-socket-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --tsconfig=tsconfig.json --external:pg-native --external:bufferutil --external:utf-8-validate --outfile=dist/index.cjs",
    "typecheck": "tsc",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
