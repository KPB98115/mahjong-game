{
  "name": "mahjong-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f web",
    "compose:logs:socket": "docker compose logs -f socket-server",
    "socket:dev": "npm run dev --prefix socket-server",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "db:migrate": "void db migrate",
    "db:status": "void db status",
    "db:generate": "void db generate",
    "db:reset": "void db reset --yes",
    "db:seed": "void db seed --yes",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:socket": "tsc --noEmit --project socket-server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run fmt:check && npm test",
    "bot:play": "tsx --tsconfig scripts/tsconfig.json scripts/playBotHand.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.11.9",
    "pg": "^8.23.1",
    "vue": "^3.5.30",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@void/vue": "1.1.11",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.2.0",
    "vite-plus": "^1.2.0",
    "vitest": "^5.0.5",
    "void": "^1.1.11"
  },
  "overrides": {
    "vite": "$vite"
  }
}
